# Required
HF_TOKEN=hf_your_token_here

# With defaults (inference.py reads these)
API_BASE_URL=https://router.huggingface.co/v1
MODEL_NAME=Qwen/Qwen2.5-72B-Instruct

# For local Docker testing only
LOCAL_IMAGE_NAME=methanol-apc-env

# Azure Digital Twins (OPTIONAL — only if using Azure DT integration)
# See docs/integrations/azure-digital-twins.md for full setup guide
#
# Runtime — needed by methanol_apc_env to read/write the cloud twin graph
# AZURE_DIGITAL_TWINS_URL=https://<your-adt-instance>.api.<region-short>.digitaltwins.azure.net
# AZURE_TENANT_ID=<your-azure-tenant-guid>
#
# Provisioning — needed only by scripts/setup_azure*.py, scripts/provision_adt.py, etc.
# AZURE_SUBSCRIPTION_ID=<your-azure-subscription-guid>
# AZURE_RESOURCE_GROUP=<your-resource-group-name>
# AZURE_LOCATION=<azure-region>            # e.g. eastus, westeurope
# AZURE_ADT_NAME=<your-adt-instance-name>
# AZURE_IOT_HUB_NAME=<your-iot-hub-name>
# AZURE_STORAGE_ACCOUNT=<your-storage-account-name>   # must be globally unique, lowercase, 3-24 chars

# OPC-UA Bridge (OPTIONAL — only if connecting to real plant DCS)
# OPCUA_ENDPOINT=opc.tcp://plant-dcs.local:4840

# Redis State Store (OPTIONAL — for distributed multi-agent coordination)
# REDIS_URL=redis://localhost:6379/0

# For remote Space testing
# SPACE_URL=https://glitchfilter-methanol-apc-env.hf.space
